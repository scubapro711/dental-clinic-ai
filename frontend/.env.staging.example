# Staging Environment Configuration
# Copy this file to .env.staging and fill in the values

# Environment
NODE_ENV=staging

# API Configuration
VITE_API_URL=https://staging-api.dentaflow.com
VITE_API_TIMEOUT=30000

# Feature Flags
VITE_ENABLE_DASHBOARD_CUSTOMIZATION=true
VITE_ENABLE_DASHBOARD_DRAG_DROP=false
VITE_ENABLE_DASHBOARD_TEMPLATES=false
VITE_ENABLE_WIDGET_RESIZE=false

# Monitoring & Analytics
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
VITE_SENTRY_ENVIRONMENT=staging
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0

# Analytics
VITE_GA_TRACKING_ID=UA-XXXXXXXXX-X
VITE_MIXPANEL_TOKEN=your-mixpanel-token

# Other Configuration
VITE_ENABLE_DEBUG=true
VITE_LOG_LEVEL=debug

