<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>  
	<!-- Groups linked to the category -->
	<record model="ir.module.category" id="dental_group_category">
			<field name="name">Dental Management</field>
			<field name="sequence">200</field>
		</record>
		
	<!-- res.groups.privilege -->
	<record id="group_dental_user_menu_prevelege" model="res.groups.privilege">
			<field name="name">Receptionist</field>
			<field name="category_id" ref="dental_group_category"/>
		</record>
		
	<record id="group_dental_mng_menu_prevelege" model="res.groups.privilege">
			<field name="name">Admin</field>
			<field name="category_id" ref="dental_group_category"/>
		</record>
		
	<record id="group_dental_doc_menu_prevelege" model="res.groups.privilege">
			<field name="name">Doctor</field>
			<field name="category_id" ref="dental_group_category"/>
		</record>

	<!-- Res.Groups -->
	<record id="group_dental_user_menu" model="res.groups">
	        <field name="name">Dental / Receptionist</field>
			<field name="privilege_id" ref="group_dental_user_menu_prevelege"/>

	    </record>
	    <record id="group_dental_mng_menu" model="res.groups">
	        <field name="name">Dental / Admin</field>
			<field name="privilege_id" ref="group_dental_mng_menu_prevelege"/>

	    </record>
	    <record id="group_dental_doc_menu" model="res.groups">
	        <field name="name">Dental / Doctor</field>
			<field name="privilege_id" ref="group_dental_doc_menu_prevelege"/>

	    </record>
	</data>
	<!-- <data>
		<record id="group_dental_user_menu" model="res.groups">
			<field name="name">Dental / Receptionist</field>

		</record>
		<record id="group_dental_mng_menu" model="res.groups">
			<field name="name">Dental / Admin</field>

		</record>
		<record id="group_dental_doc_menu" model="res.groups">
			<field name="name">Dental / Doctor</field>

		</record>
	</data> -->

	<data noupdate="1">
		<record id="model_medical_appointment_rule" model="ir.rule">
			<field name="name">Doctor Rule</field>
			<field ref="model_medical_appointment" name="model_id" />
			<field name="domain_force">[('user_id','=',user.id)]</field>
			<field name="groups" eval="[(4, ref('group_dental_doc_menu'))]" />
		</record>

		<record id="model_hr_employee_personal_rule2" model="ir.rule">
			<field name="name">Admin Rule</field>
			<field ref="model_medical_appointment" name="model_id" />
			<field name="domain_force">[(1,'=',1)]</field>
			<field name="groups"
				eval="[(4, ref('group_dental_mng_menu')) ,(4, ref('group_dental_user_menu')) ]" />
		</record>

	</data>

</odoo>