    inherit_id="website.layout">
    <xpath expr="//footer" position="replace"></xpath>
    </template> -->

    <template id="doyenne_footer" name="Doyenne Footer"
    inherit_id="website.layout">
    <xpath expr="//div[@id='footer']" position="replace"></xpath>
    </template>


    </data>
</odoo>